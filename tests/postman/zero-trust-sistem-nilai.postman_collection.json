    {
      "name": "01 - Autentikasi & Token",
      "item": [
        {
          "name": "Login dosen1 (device terdaftar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "{{devDosen1}}"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Access token 10 menit + refresh token 1 hari. Token disimpan ke variabel dosen1Token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dosen1\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('access token 10 menit', () => pm.expect(b.expires_in).to.eql(600));",
                  "pm.test('refresh token 1 hari', () => pm.expect(b.refresh_expires_in).to.eql(86400));",
                  "pm.test('role dosen', () => pm.expect(b.user.role).to.eql('dosen'));",
                  "pm.collectionVariables.set('dosen1Token', b.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
