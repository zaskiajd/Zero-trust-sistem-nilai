# Salin ke .env (atau jalankan: npm run setup yang membuat .env dengan secret acak).
# JANGAN commit file .env. Nilai di bawah hanya contoh.

HOST=127.0.0.1
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# URL yang dipakai Service Nilai untuk memanggil gateway (komunikasi antar-service wajib lewat gateway)
GATEWAY_URL=http://127.0.0.1:3000
# URL tujuan proxy di gateway
NILAI_URL=http://127.0.0.1:3001
TRANSKRIP_URL=http://127.0.0.1:3002

# Secret penandatangan JWT (HS256). Minimal 32 karakter acak.
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Secret yang ditambahkan gateway ke header X-Gateway-Secret
GATEWAY_SECRET=ganti-dengan-gateway-secret-acak
# Kredensial Service Nilai untuk POST /auth/service
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-client-secret-acak

# Jam akses perubahan/finalisasi nilai (format HH:MM, rentang [mulai, selesai)).
# "24:00" didukung sebagai akhir hari. Rentang melewati tengah malam juga didukung.
ACCESS_HOURS_START=07:00
ACCESS_HOURS_END=21:00
# Zona waktu IANA untuk jam akses
ACCESS_TZ=Asia/Jakarta

# Lokasi file database SQLite bersama
DB_PATH=./database/sistem-nilai.db
